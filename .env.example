# Copy to .env and fill in. Never commit .env.
# The app runs fully without this file — it falls back to mock mode.

# Sarvam AI key (Indic translation + chat). Leave blank to stay in mock mode.
SARVAM_API_KEY=

# auto = use Sarvam when a key exists, mock otherwise.
# mock = force mock mode even with a key present (use this on stage if Wi-Fi dies).
VE_PROVIDER=auto

# Sarvam translation model and register. mayura:v1 takes 1000 chars/request.
TRANSLATE_MODEL=mayura:v1
CHAT_MODEL=sarvam-m
TRANSLATE_MODE=modern-colloquial
VE_REQUEST_TIMEOUT=20
VE_REQUEST_RETRIES=1

# Optional: point the SQLite database somewhere else (tests use this).
# VE_DB_PATH=data/app.db

# Cut-list features, off by default.
VE_ENABLE_SPEECH=false
VE_ENABLE_GENERATED_QUIZ=false
